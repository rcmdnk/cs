#!/usr/bin/env bash
## Description {{{
#
# cs: claude with session selection
#
# Homepage: https://github.com/rcmdnk/cs
#
_CS_NAME="cs"
_CS_VERSION="v0.1.1"
_CS_DATE="13/Oct/2026"
# }}}

# This file is meant to be sourced from bash or zsh, e.g. in .bashrc/.zshrc:
#   source /path/to/cs
# then run:
#   cs
#
# Variables (set before sourcing to override):
#   SELECTION_TOOL        comma separated selectors to try (default: sentaku,peco,fzy,fzf)
#   CS_MAX_SESSIONS       number of sessions to list
#   CS_CWD_MAX_LENGTH     cut directory names longer than this
#   CS_MESSAGE_MAX_LENGTH cut the first message and the session name longer than this
#   CS_ENTRYPOINT         list only sessions whose records have this entrypoint
#                         (cli: started from the terminal; sdk-py etc. are subagent runs)
#   CLAUDE_CONFIG_DIR     Claude Code configuration directory (default: ~/.claude)

# This file must be sourced, not executed {{{
if [ -n "${ZSH_VERSION:-}" ];then
  case $ZSH_EVAL_CONTEXT in
    *:file*) ;;
    *) echo "cs must be sourced: source $0" >&2; exit 1;;
  esac
elif [ "${BASH_SOURCE[0]}" = "$0" ];then
  echo "cs must be sourced: source $0" >&2
  exit 1
fi # }}}

_cs_select () { # Select from list {{{
  local input=("$@")
  local tool=""
  local -a opts
  local t
  local -a values
  local line value
  opts=()
  for t in $(echo "${SELECTION_TOOL:-sentaku,peco,fzy,fzf}"|tr , ' ');do
    if type "$t" >& /dev/null ;then
      tool=$t
      break
    fi
  done
  if [[ "$tool" = "sentaku" ]];then
    opts=(-s line)
  fi
  if [ -n "$tool" ];then
    # ${opts[@]+...}: an empty array is an error with set -u in bash < 4.4
    printf '%s\n' "${input[*]}"|"$tool" ${opts[@]+"${opts[@]}"}
  else
    values=()
    while IFS=$'\n' read -r line; do values+=("$line"); done < <(printf '%s\n' "${input[*]}")
    select value in "${values[@]}";do
      printf '%s\n' "$value"
      break
    done
  fi
} # }}}

_cs_sessions () { # Read "mtime path" lines (newest first) from stdin and print the sessions {{{
  # Each file is read until "entrypoint":"$CS_ENTRYPOINT", cwd, sessionId and
  # the first user prompt are found; stops after CS_MAX_SESSIONS sessions.
  # The session name is the last custom-title record in the last 128KB of the file.
  # Output: mtime, cwd, first prompt, sessionId and name separated by \037.
  # LC_ALL=C makes awk work on bytes in every awk.
  LC_ALL=C awk -v ep="$CS_ENTRYPOINT" -v nmax="$CS_MAX_SESSIONS" \
    -v msgmax="$CS_MESSAGE_MAX_LENGTH" '
  # The JSON string at s (text right after the opening quote) up to the
  # closing quote with escapes resolved; \n, \t etc. become spaces.
  # With max > 0, stop after max*4 bytes (enough for max characters in UTF-8)
  # at a character boundary.
  function json_str(s, max,   out, n, i, c, nx) {
    out = ""
    n = length(s)
    for (i = 1; i <= n; i++) {
      c = substr(s, i, 1)
      if (c == "\"") break
      if (c == "\\") {
        i++
        c = substr(s, i, 1)
        if (c == "n" || c == "t" || c == "r" || c == "b" || c == "f") c = " "
        else if (c == "u") c = "\\u"
      }
      out = out c
      if (max > 0 && length(out) >= max * 4) {
        nx = substr(s, i + 1, 1)
        if (nx < "\200" || nx >= "\300") break
      }
    }
    return out
  }
  # The string value of the first "key":"..." in line ("" if there is none)
  function json_value(line, key, max,   k, p) {
    k = "\"" key "\":\""
    p = index(line, k)
    if (p == 0) return ""
    return json_str(substr(line, p + length(k)), max)
  }
  # The first text of message.content in a user record line
  function first_text(line,   p, c) {
    p = index(line, "\"content\":")
    if (p == 0) return ""
    c = substr(line, p + 10)
    if (substr(c, 1, 1) == "\"") return json_str(substr(c, 2), msgmax)
    if (substr(c, 1, 1) == "[") return json_value(c, "text", msgmax)
    return ""
  }
  BEGIN {
    if (nmax <= 0) exit
    epkey = "\"entrypoint\":\"" ep "\""
    sq = "\047"
    dq = "\042"
  }
  {
    sp = index($0, " ")
    ts = substr($0, 1, sp - 1)
    f = substr($0, sp + 1)
    ok = 0
    got_cwd = 0; got_id = 0; got_prompt = 0
    cwd = ""; id = ""; prompt = ""; text = ""; meta = ""
    while ((getline line < f) > 0) {
      if (!got_cwd && index(line, "\"cwd\"")) {
        cwd = json_value(line, "cwd", 0)
        got_cwd = 1
      }
      if (!got_id && index(line, "\"sessionId\"")) {
        id = json_value(line, "sessionId", 0)
        got_id = 1
      }
      # The prompt: the first user text which is not a tool result, a meta record or
      # a <tag> (slash command records, system reminders etc.)
      if (!got_prompt && index(line, "\"type\":\"user\"") && !index(line, "\"tool_use_id\"")) {
        t = first_text(line)
        if (index(line, "\"isMeta\":true")) {
          if (meta == "") meta = t
        } else {
          if (text == "") text = t
          sub(/^ +/, "", t)
          if (t != "" && substr(t, 1, 1) != "<") {
            prompt = t
            got_prompt = 1
          }
        }
      }
      if (!ok && index(line, epkey)) ok = 1
      if (ok && got_cwd && got_id && got_prompt) break
    }
    close(f)
    if (!ok) next
    n++
    tss[n] = ts
    files[n] = f
    cwds[n] = cwd
    ids[n] = id
    prompts[n] = (prompt != "") ? prompt : (text != "") ? text : meta
    if (n >= nmax) exit
  }
  END {
    for (i = 1; i <= n; i += 50) {
      cmd = "tail -c 131072 --"
      for (j = i; j < i + 50 && j <= n; j++) {
        f = files[j]
        gsub(sq, sq dq sq dq sq, f)
        cmd = cmd " " sq f sq
      }
      cmd = cmd " 2>/dev/null"
      while ((cmd | getline line) > 0) {
        if (index(line, "\"type\":\"custom-title\"")) {
          id = json_value(line, "sessionId", 0)
          if (id != "") names[id] = json_value(line, "customTitle", msgmax)
        }
      }
      close(cmd)
    }
    for (i = 1; i <= n; i++) {
      printf "%s\037%s\037%s\037%s\037%s\n", tss[i], cwds[i], prompts[i], ids[i], names[ids[i]]
    }
  }'
} # }}}

_cs_check_number () { # name value {{{
  case $2 in
    ''|*[!0-9]*)
      echo "cs: $1 must be a number: $2" >&2
      return 1;;
  esac
} # }}}

CS_MAX_SESSIONS=${CS_MAX_SESSIONS:-20}
CS_CWD_MAX_LENGTH=${CS_CWD_MAX_LENGTH:-20}
CS_MESSAGE_MAX_LENGTH=${CS_MESSAGE_MAX_LENGTH:-30}
CS_ENTRYPOINT=${CS_ENTRYPOINT:-cli} # list only sessions started from the terminal (sdk-py etc. are subagent runs)
cs () { # {{{ claude with session selection
  local sessions ids dirs n list ts d cwd dir first id name selected date_cmd mark limit keep
  case "${1:-}" in
    -v|--version)
      printf '%s %s %s\n' "$_CS_NAME" "$_CS_VERSION" "$_CS_DATE"
      return 0;;
    -h|--help)
      cat <<EOF
Usage: cs [-h] [-v]

Select a Claude Code session from the recent ones,
move to its directory and run claude --resume.

  -h, --help     Show this help
  -v, --version  Show version

Variables (set before sourcing cs):
  SELECTION_TOOL         Selection tools to try, comma separated (default: sentaku,peco,fzy,fzf)
  CS_MAX_SESSIONS        Number of sessions to list (default: 20)
  CS_CWD_MAX_LENGTH      Directory names longer than this are shortened (default: 20)
  CS_MESSAGE_MAX_LENGTH  The first message and the session name are cut to this length (default: 30)
  CS_ENTRYPOINT          Only sessions with this entrypoint are listed (default: cli)
  CLAUDE_CONFIG_DIR      Claude Code configuration directory (default: ~/.claude)
EOF
      return 0;;
    "") ;;
    *)
      echo "cs: unknown option: $1" >&2
      return 1;;
  esac
  _cs_check_number CS_MAX_SESSIONS "$CS_MAX_SESSIONS" || return 1
  _cs_check_number CS_CWD_MAX_LENGTH "$CS_CWD_MAX_LENGTH" || return 1
  _cs_check_number CS_MESSAGE_MAX_LENGTH "$CS_MESSAGE_MAX_LENGTH" || return 1
  local -a stat_fmt
  # find -printf is GNU only: get mtime with stat (GNU: -c, BSD: -f)
  if [[ $(stat --version 2>/dev/null) == *GNU* ]];then
    stat_fmt=(-c '%Y %n')
  else
    stat_fmt=(-f '%m %N')
  fi
  if [ -n "${ZSH_VERSION:-}" ];then
    if zmodload zsh/datetime 2>/dev/null;then
      date_cmd=strftime
    else
      date_cmd=date
    fi
  elif [ "${BASH_VERSINFO[0]}" -gt 4 ] \
    || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 2 ]; };then
    date_cmd=printf
  else
    date_cmd=date
  fi
  if [ "$date_cmd" = date ];then
    if [[ $(date --version 2>/dev/null) == *GNU* ]];then
      date_cmd=gnu_date
    else
      date_cmd=bsd_date
    fi
  fi
  sessions=$(find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/" -maxdepth 2 -name '*.jsonl' \
    -exec stat "${stat_fmt[@]}" {} + | sort -rn | _cs_sessions)
  if [ -z "$sessions" ];then
    echo "No claude session found (CS_ENTRYPOINT=${CS_ENTRYPOINT})" >&2
    return 1
  fi
  ids=()
  dirs=()
  n=0
  list=""
  while IFS=$'\037' read -r ts cwd first id name; do
    ts=${ts%.*}
    case $date_cmd in
      strftime) strftime -s d '%m-%d %H:%M' "$ts";;
      printf) printf -v d '%(%m-%d %H:%M)T' "$ts";;
      gnu_date) d=$(date -d @"$ts" '+%m-%d %H:%M');;
      *) d=$(date -r "$ts" '+%m-%d %H:%M');;
    esac
    dir=$cwd
    # A directory which does not exist any more is marked with !
    mark=""
    limit=$CS_CWD_MAX_LENGTH
    if [ ! -d "$dir" ]; then
      mark="!"
      limit=$((limit - 1))
    fi
    if [ ${#cwd} -gt "$limit" ]; then
      keep=$((limit - 3))
      if [ "$keep" -lt 1 ];then
        keep=1
      fi
      cwd="...${cwd: -$keep}"
    fi
    cwd="$mark$cwd"
    # Cut by characters, not bytes (GNU cut -c counts bytes)
    first=${first:0:${CS_MESSAGE_MAX_LENGTH}}
    name=${name:0:${CS_MESSAGE_MAX_LENGTH}}
    ids+=("$id")
    dirs+=("$dir")
    if [ -n "$name" ];then
      first="[$name] $first"
    fi
    # Keep backslashes in values literal: no echo -e here (zsh echo interprets them too)
    list="$list$d"$'\t'"$cwd"$'\t'"$first"$'\n'
    n=$((n + 1))
  done <<< "$sessions"
  list=$(printf '%s' "$list" | column -t -s $'\t' | sed 's/ *$//')
  selected=$(_cs_select "$list")
  if [ -z "$selected" ]; then
    return
  fi
  n=$(printf '%s\n' "$list" | grep -nxF -- "$selected" | head -n 1 | cut -d: -f1)
  if [ -z "$n" ]; then
    echo "Selected line is not in the list: $selected" >&2
    return 1
  fi
  if [ -z "${ZSH_VERSION:-}" ] || setopt | grep -q ksharrays;then
    n=$((n - 1))
  fi
  if [ -d "${dirs[n]}" ];then
    cd "${dirs[n]}" || return $?
  else
    echo "cs: directory not found, resuming in the current directory: ${dirs[n]}" >&2
  fi
  eval "${PROMPT_COMMAND:-}"
  claude --resume "${ids[n]}"
} # }}}
